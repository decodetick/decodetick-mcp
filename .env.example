# decodetick-mcp environment

# Transport: "stdio" (default, local) or "streamable-http" (remote)
MCP_TRANSPORT=stdio

# Data API base URL + outbound-token audience (defaults shown)
# DECODETICK_API_URL=https://api.decodetick.com
# DECODETICK_API_AUDIENCE=https://api.decodetick.com

# Self-host only: your Decodetick API key (dtk_ + 40 hex). Used to authenticate
# to the data API for self-hosted deployments; it authenticates as your
# subscription tier. On the hosted service leave this unset - it is handled
# automatically. Never commit a real value.
# DECODETICK_API_KEY=dtk_0000000000000000000000000000000000000000
